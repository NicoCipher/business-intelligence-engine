# BIA-OS environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ── Reddit API (required for Reddit collector) ─────────────────────────────
# Free credentials: https://www.reddit.com/prefs/apps → create app → type: script
# Both are required together — the collector checks them as one pair.
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here

# ── GitHub API (required for GitHub collector) ─────────────────────────────
# Free token: https://github.com/settings/tokens → generate new token (fine-grained)
# "Public Repositories (read-only)" access is sufficient — no write scopes needed.
GITHUB_TOKEN=your_github_token_here

# ── Google Trends (no credentials needed) ──────────────────────────────────
# pytrends (pip install pytrends) needs no authentication at all. Nothing
# to set here — this section exists only so it's not missed as "forgotten."

# ── Database location (optional — defaults to backend/data/bia.db) ─────────
# BIA_DATA_DIR=/absolute/path/to/data/directory

# ── API server (optional — defaults shown) ────────────────────────────────
# BIA_HOST=127.0.0.1
# BIA_PORT=8000

# ── BIA Operations Console (server-only) ───────────────────────────────────
# The console calls FastAPI only from Next.js Server Components/Actions.
# Never prefix either variable with NEXT_PUBLIC_. In production both are required.
# BIA_API_BASE_URL=http://127.0.0.1:8000
# BIA_API_KEY=replace_with_the_same_private_api_key_used_by_the_backend

# ── Collector limits (optional — conservative defaults shown) ─────────────
# HN_STORY_LIMIT=80
# REDDIT_POST_LIMIT=25
# REDDIT_REQUEST_DELAY=1.0
# GITHUB_SEARCH_LIMIT=20
# GITHUB_REQUEST_DELAY=2.5
# GOOGLE_TRENDS_KEYWORD_LIMIT=20
# GOOGLE_TRENDS_REQUEST_DELAY=30.0
