# Local development environment reference.
# Set values through your local environment or tooling.
# Never commit real values.

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=
BIA_API_BASE_URL=
BIA_API_KEY=

# Optional but recommended: register a free Stack Exchange API key at
# https://stackapps.com/apps/oauth/register for predictable quota allocation.
# The collector works without this key using anonymous API access, but quota
# behavior for anonymous access is determined at runtime from API responses.
STACKEXCHANGE_API_KEY=
